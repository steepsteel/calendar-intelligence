{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calendar-intelligence",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "calendarintel.app", "custom_domain": true }],
  "vars": { "APP_ORIGIN": "https://calendarintel.app" },
  "triggers": { "crons": ["*/2 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
